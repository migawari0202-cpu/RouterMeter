<Window x:Class="RouterMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RouterMeter.Controls"
        Title="RouterMeter"
        Width="240" Height="190"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="10" BorderBrush="#333333" BorderThickness="1">
        <!-- 設定画面は持たないため、終了操作のみ右クリックメニューで提供 -->
        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened">
                <MenuItem x:Name="AlwaysOnTopMenuItem"
                          Header="常に手前に表示"
                          IsCheckable="True"
                          Click="AlwaysOnTopMenuItem_Click" />
                <Separator/>
                <MenuItem Header="一日当たりの予算を変更..." Click="ChangeBudgetMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="終了" Click="ExitMenuItem_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Margin="16" HorizontalAlignment="Center">
            <controls:PieChartControl Percentage="{Binding Percentage}"/>

            <TextBlock Text="Today" HorizontalAlignment="Center"
                       Foreground="#B5B5B5" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding SpendText}" HorizontalAlignment="Center"
                       Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,2,0,8"/>

            <TextBlock Text="{Binding RequestsText}" Style="{StaticResource InfoText}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource InfoText}" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Ellipse Width="8" Height="8" Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                           Style="{StaticResource InfoText}" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
