<Window x:Class="RouterMeter.BudgetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一日当たりの予算"
        Width="300" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="一日当たりの予算 (USD)"/>
        <TextBox x:Name="BudgetTextBox" Grid.Row="1" Margin="0,8,0,12"
                 Padding="5,3" MinWidth="120"
                 HorizontalContentAlignment="Right"
                 PreviewKeyDown="BudgetTextBox_PreviewKeyDown"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" IsCancel="True" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="保存" IsDefault="True" Padding="16,5" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
